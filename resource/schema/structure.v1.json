{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tamnd/math2/blob/main/schema/structure.v1.json",
  "title": "structure.v1",
  "description": "The tree of locators of one expression (corpus resources RS2.9), in records/resources/structure/<id>/<expression>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resource",
    "source",
    "snapshot",
    "nodes"
  ],
  "properties": {
    "resource": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{10}/e[1-9][0-9]*$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "page": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reading"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "resource"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ],
      "properties": {
        "resource": {
          "type": "string"
        },
        "at": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
