{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tamnd/math2/blob/main/schema/resource.v1.json",
  "title": "resource.v1",
  "description": "One work of the catalogue of math2 (corpus resources RS2.4). One record is one line of records/resources/<shard>.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "title",
    "catalogue",
    "history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{10}$"
    },
    "kind": {
      "enum": [
        "monograph",
        "textbook",
        "edited-volume",
        "proceedings",
        "problem-book",
        "handbook",
        "encyclopedia",
        "table",
        "chapter",
        "article",
        "preprint",
        "conference-paper",
        "survey",
        "thesis",
        "report",
        "lecture-notes",
        "course",
        "course-material",
        "competition",
        "problem-set",
        "journal",
        "series",
        "video-series",
        "software",
        "dataset",
        "website",
        "manuscript"
      ]
    },
    "genre": {
      "type": "array",
      "items": {
        "enum": [
          "survey",
          "expository",
          "research",
          "historical",
          "problems",
          "solutions",
          "olympiad",
          "popular",
          "teaching"
        ]
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title_en": {
      "type": "string"
    },
    "creators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/creator"
      }
    },
    "date": {
      "$ref": "#/$defs/date"
    },
    "msc": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "level": {
      "enum": [
        "bachelor",
        "master",
        "doctoral",
        "habilitation"
      ]
    },
    "ids": {
      "$ref": "#/$defs/ids"
    },
    "expressions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expression"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "catalogue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/catalogue_record"
      }
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "ids": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2
          }
        ]
      }
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "creator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "author",
            "editor",
            "translator",
            "instructor",
            "contributor",
            "advisor"
          ]
        },
        "ids": {
          "$ref": "#/$defs/ids"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "from"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "code"
      ],
      "properties": {
        "system": {
          "type": "string"
        },
        "code": {
          "type": "string"
        }
      }
    },
    "licence_read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "on",
        "by"
      ],
      "properties": {
        "at": {
          "type": "string"
        },
        "on": {
          "$ref": "#/$defs/day"
        },
        "by": {
          "type": "string"
        }
      }
    },
    "public_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "us",
        "eu",
        "basis"
      ],
      "properties": {
        "us": {
          "type": "boolean"
        },
        "eu": {
          "type": "boolean"
        },
        "basis": {
          "type": "string"
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class"
      ],
      "properties": {
        "class": {
          "enum": [
            "open",
            "share-alike-nc",
            "verbatim",
            "gfdl",
            "record"
          ]
        },
        "licence": {
          "type": "string"
        },
        "licence_read": {
          "$ref": "#/$defs/licence_read"
        },
        "text": {
          "enum": [
            "open-text",
            "free-to-read",
            "closed",
            "lost"
          ]
        },
        "public_domain": {
          "$ref": "#/$defs/public_domain"
        }
      }
    },
    "manifestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^m[1-9][0-9]*$"
        },
        "kind": {
          "enum": [
            "print",
            "pdf",
            "html",
            "latex",
            "pretext",
            "video",
            "page"
          ]
        },
        "publisher": {
          "type": "string"
        },
        "place": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "ids": {
          "$ref": "#/$defs/ids"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "access": {
          "$ref": "#/$defs/access"
        }
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^e[1-9][0-9]*$"
        },
        "kind": {
          "enum": [
            "edition",
            "translation",
            "version",
            "offering"
          ]
        },
        "label": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "contributors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/creator"
          }
        },
        "ids": {
          "$ref": "#/$defs/ids"
        },
        "structure": {
          "type": "string"
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "manifestations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/manifestation"
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "to"
      ],
      "properties": {
        "kind": {
          "enum": [
            "part_of",
            "translation_of",
            "version_of",
            "reprint_of",
            "based_on",
            "uses_text",
            "reviews",
            "solves",
            "corrects"
          ]
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "volume": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "by"
      ],
      "properties": {
        "value": {
          "enum": [
            "in",
            "border",
            "out",
            "duplicate",
            "deferred"
          ]
        },
        "target": {
          "type": "string"
        },
        "until": {
          "$ref": "#/$defs/day"
        },
        "reason": {
          "type": "string"
        },
        "rule": {
          "type": "string"
        },
        "by": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "catalogue_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "snapshot",
        "native_id",
        "level"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "work",
            "expression",
            "manifestation"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "at",
        "by"
      ],
      "properties": {
        "op": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/day"
        },
        "by": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
