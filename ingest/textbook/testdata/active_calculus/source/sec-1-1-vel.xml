  <subsection>
    <title>Position and average velocity</title>
    <definition xml:id="def-avg-vel">
      <statement>
        <p>The <term>average velocity</term> of a position function <m>s</m> on <m>[a,b]</m> is</p>
        <me>\frac{s(b)-s(a)}{b-a}</me>
      </statement>
    </definition>
