{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tamnd/math2/blob/main/schema/node.v1.json",
  "title": "math2 node, schema v1",
  "description": "The front matter of a node file in nodes/. Spec 04.5 gives the form. Each kind has its own fields. The x-m2-sections keyword gives the body sections of each kind, in order. The x-m2-edges keyword lists the 23 edge types. The x-m2-order keyword gives the order of the top-level keys in the canonical form. Nested keys use the order of their properties in this file.",
  "type": "object",
  "required": [
    "tag",
    "kind",
    "name"
  ],
  "properties": {
    "tag": {
      "$ref": "#/$defs/ref"
    },
    "kind": {
      "enum": [
        "concept",
        "definition",
        "statement",
        "conjecture",
        "problem",
        "example",
        "counterexample",
        "object",
        "proof",
        "computation",
        "topic"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "aliases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slug"
      },
      "uniqueItems": true
    },
    "msc": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/msc"
      },
      "uniqueItems": true
    },
    "topics": {
      "description": "The topics that this node is part of. This is the part_of edge.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "uses": {
      "description": "The nodes that this node depends on. This is the uses edge.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "analogous_to": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/analogous_to"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "same_as": {
      "$ref": "#/$defs/same_as"
    },
    "close_to": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/close_to"
      }
    },
    "aligned": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/aligned"
      }
    },
    "history": {
      "$ref": "#/$defs/history"
    },
    "retired": {
      "$ref": "#/$defs/retired"
    },
    "resolved_by": {
      "description": "The statements that settle this conjecture or problem. This is the resolved_by edge.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    }
  },
  "x-m2-order": [
    "tag",
    "kind",
    "role",
    "name",
    "aliases",
    "msc",
    "topics",
    "about",
    "defines",
    "proves",
    "instance_of",
    "specializes",
    "claim",
    "engine",
    "output",
    "certificate",
    "uses",
    "methods",
    "proofs",
    "formal",
    "implies",
    "equivalent",
    "refutes",
    "resolves",
    "resolved_by",
    "generalizes",
    "bounds",
    "analogous_to",
    "sources",
    "same_as",
    "close_to",
    "aligned",
    "history",
    "retired"
  ],
  "propertyNames": {
    "not": {
      "enum": [
        "status",
        "verified",
        "proved",
        "evidence",
        "fidelity",
        "level",
        "checked"
      ]
    },
    "description": "Rule S03: status is computed. A node file never states it."
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "concept"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "specializes": {
            "description": "Every instance of this concept is an instance of the target. This is the specializes edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          }
        },
        "x-m2-sections": {
          "required": [
            "Summary"
          ],
          "allowed": [
            "Summary",
            "Remarks",
            "Explanations"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "definition"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "defines": {
            "$ref": "#/$defs/ref",
            "description": "The concept that this definition defines. This is the defines edge."
          },
          "formal": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/formal"
            }
          },
          "equivalent": {
            "description": "Definitions that are equivalent to this one. This is the equivalent edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/via_edge"
            }
          }
        },
        "x-m2-sections": {
          "required": [
            "Definition"
          ],
          "allowed": [
            "Definition",
            "Remarks",
            "Explanations"
          ]
        },
        "required": [
          "defines"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "statement"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "about": {
            "description": "The main subjects of this node. This is the about edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          },
          "role": {
            "enum": [
              "theorem",
              "lemma",
              "proposition",
              "corollary",
              "fact",
              "axiom"
            ]
          },
          "proofs": {
            "description": "The proof nodes, in the order that readers see them.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          },
          "formal": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/formal"
            }
          },
          "implies": {
            "description": "This is the implies edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/via_edge"
            }
          },
          "equivalent": {
            "description": "This is the equivalent edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/via_edge"
            }
          },
          "refutes": {
            "description": "This is the refutes edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/via_edge"
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "outcome"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "$ref": "#/$defs/ref"
                },
                "outcome": {
                  "enum": [
                    "proved",
                    "disproved",
                    "settled"
                  ]
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "generalizes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "map"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "$ref": "#/$defs/ref"
                },
                "map": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "bounds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "target",
                "side",
                "value",
                "via"
              ],
              "additionalProperties": false,
              "properties": {
                "target": {
                  "$ref": "#/$defs/ref"
                },
                "side": {
                  "enum": [
                    "lower",
                    "upper"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "via": {
                  "$ref": "#/$defs/ref"
                }
              }
            }
          }
        },
        "x-m2-sections": {
          "required": [
            "Statement"
          ],
          "allowed": [
            "Statement",
            "Remarks",
            "History",
            "Explanations"
          ]
        },
        "required": [
          "role"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "conjecture"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "about": {
            "description": "The main subjects of this node. This is the about edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          },
          "formal": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/formal"
            }
          }
        },
        "x-m2-sections": {
          "required": [
            "Statement"
          ],
          "allowed": [
            "Statement",
            "Remarks",
            "History",
            "Explanations"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "problem"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "about": {
            "description": "The main subjects of this node. This is the about edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          },
          "formal": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/formal"
            }
          }
        },
        "x-m2-sections": {
          "required": [
            "Problem"
          ],
          "allowed": [
            "Problem",
            "Remarks",
            "History",
            "Explanations"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "example"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "instance_of": {
            "description": "This is the instance_of edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          },
          "formal": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/formal"
            }
          }
        },
        "x-m2-sections": {
          "required": [
            "Example"
          ],
          "allowed": [
            "Example",
            "Remarks",
            "Explanations"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "counterexample"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "refutes": {
            "description": "This is the refutes edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/via_edge"
            }
          },
          "formal": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/formal"
            }
          }
        },
        "x-m2-sections": {
          "required": [
            "Counterexample"
          ],
          "allowed": [
            "Counterexample",
            "Remarks",
            "Explanations"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "object"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "instance_of": {
            "description": "This is the instance_of edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          }
        },
        "x-m2-sections": {
          "required": [
            "Description"
          ],
          "allowed": [
            "Description",
            "Remarks",
            "Explanations"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "proof"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "proves": {
            "$ref": "#/$defs/ref",
            "description": "The one statement that this proof proves. This is the proves edge."
          },
          "formal": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/formal"
            }
          },
          "methods": {
            "description": "The methods that the proof uses. This is the method edge.",
            "type": "array",
            "items": {
              "$ref": "#/$defs/ref"
            },
            "uniqueItems": true
          }
        },
        "x-m2-sections": {
          "required": [],
          "allowed": [
            "Proof",
            "Idea"
          ]
        },
        "required": [
          "proves"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "computation"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "engine": {
            "type": "object",
            "required": [
              "image",
              "entry"
            ],
            "additionalProperties": false,
            "properties": {
              "image": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*@sha256:[0-9a-f]{64}$"
              },
              "entry": {
                "type": "string",
                "minLength": 1
              },
              "inputs": {
                "type": "object"
              },
              "seed": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "resources": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cpu": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "mem": {
                    "type": "string"
                  },
                  "wall": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "output": {
            "type": "object",
            "required": [
              "hash"
            ],
            "additionalProperties": false,
            "properties": {
              "hash": {
                "type": "string",
                "pattern": "^blake3:[0-9a-f]{64}$"
              },
              "summary": {
                "type": "string"
              }
            }
          },
          "certificate": {
            "type": "object",
            "required": [
              "kind",
              "artefact",
              "checker"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "artefact": {
                "type": "string",
                "pattern": "^blake3:[0-9a-f]{64}$"
              },
              "checker": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]*@sha256:[0-9a-f]{64}$"
              },
              "checker_entry": {
                "type": "string"
              }
            }
          }
        },
        "x-m2-sections": {
          "required": [
            "Description"
          ],
          "allowed": [
            "Description",
            "Remarks"
          ]
        },
        "required": [
          "claim",
          "engine"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "topic"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {},
        "x-m2-sections": {
          "required": [],
          "allowed": [
            "Summary",
            "Remarks"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "x-m2-edges": [
    {
      "name": "proves",
      "group": "logical",
      "from": "proof",
      "to": "statement",
      "field": "proves"
    },
    {
      "name": "uses",
      "group": "logical",
      "from": "statement, proof, definition",
      "to": "any",
      "field": "uses"
    },
    {
      "name": "implies",
      "group": "logical",
      "from": "statement",
      "to": "statement",
      "field": "implies"
    },
    {
      "name": "equivalent",
      "group": "logical",
      "from": "statement or definition",
      "to": "the same kind",
      "field": "equivalent"
    },
    {
      "name": "refutes",
      "group": "logical",
      "from": "counterexample or statement",
      "to": "statement or conjecture",
      "field": "refutes"
    },
    {
      "name": "resolves",
      "group": "logical",
      "from": "statement",
      "to": "conjecture or problem",
      "field": "resolves"
    },
    {
      "name": "generalizes",
      "group": "logical",
      "from": "statement",
      "to": "statement",
      "field": "generalizes"
    },
    {
      "name": "bounds",
      "group": "logical",
      "from": "statement",
      "to": "problem",
      "field": "bounds"
    },
    {
      "name": "defines",
      "group": "conceptual",
      "from": "definition",
      "to": "concept",
      "field": "defines"
    },
    {
      "name": "instance_of",
      "group": "conceptual",
      "from": "example or object",
      "to": "concept",
      "field": "instance_of"
    },
    {
      "name": "about",
      "group": "conceptual",
      "from": "statement, conjecture or problem",
      "to": "concept",
      "field": "about"
    },
    {
      "name": "specializes",
      "group": "conceptual",
      "from": "concept",
      "to": "concept",
      "field": "specializes"
    },
    {
      "name": "method",
      "group": "conceptual",
      "from": "proof",
      "to": "concept in the methods topic",
      "field": "methods"
    },
    {
      "name": "analogous_to",
      "group": "conceptual",
      "from": "any",
      "to": "any",
      "field": "analogous_to"
    },
    {
      "name": "part_of",
      "group": "conceptual",
      "from": "any",
      "to": "topic",
      "field": "topics"
    },
    {
      "name": "formalizes",
      "group": "record",
      "from": "formal declaration",
      "to": "node",
      "field": "formal"
    },
    {
      "name": "source",
      "group": "record",
      "from": "node",
      "to": "record",
      "field": "sources"
    },
    {
      "name": "aligned",
      "group": "record",
      "from": "paper result",
      "to": "node",
      "field": "aligned"
    },
    {
      "name": "same_as",
      "group": "record",
      "from": "node",
      "to": "external id",
      "field": "same_as"
    },
    {
      "name": "close_to",
      "group": "record",
      "from": "node",
      "to": "external id",
      "field": "close_to"
    },
    {
      "name": "cites",
      "group": "record",
      "from": "record",
      "to": "record",
      "field": null
    },
    {
      "name": "resolved_by",
      "group": "record",
      "from": "conjecture or problem",
      "to": "statement",
      "field": "resolved_by"
    },
    {
      "name": "successor",
      "group": "record",
      "from": "retired node",
      "to": "node",
      "field": "retired.successor"
    }
  ],
  "$defs": {
    "tag": {
      "description": "A permanent tag: 10 characters of Crockford base32, without I, L, O and U, of which the last is a check character, or a legacy tag of 6 characters. Rule T09 checks the check character.",
      "type": "string",
      "pattern": "^([0-9A-HJKMNP-TV-Z]{6}|[0-9A-HJKMNP-TV-Z]{10})$"
    },
    "provisional": {
      "description": "A provisional id: ~ and 8 lowercase hex characters. It is valid only before merge.",
      "type": "string",
      "pattern": "^~[0-9a-f]{8}$"
    },
    "ref": {
      "description": "A reference to a node: a tag, or a provisional id inside its own pull request.",
      "anyOf": [
        {
          "$ref": "#/$defs/tag"
        },
        {
          "$ref": "#/$defs/provisional"
        }
      ]
    },
    "msc": {
      "description": "An MSC2020 code, for example 20D60, 20Dxx, 20-XX or 20-01. Quote codes that contain E, such as \"20E05\".",
      "type": "string",
      "pattern": "^[0-9]{2}(-XX|-[0-9]{2}|[A-Z]xx|[A-Z][0-9]{2})$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "via_edge": {
      "description": "An edge that a proof or a computation supports. Rule G10 needs via.",
      "type": "object",
      "required": [
        "target",
        "via"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/ref"
        },
        "via": {
          "$ref": "#/$defs/ref"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "source": {
      "description": "Where the node is stated or proved. Give exactly one identifier and a locator.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zbmath": {
          "description": "zbMATH Open document id",
          "type": "string",
          "minLength": 1
        },
        "arxiv": {
          "description": "arXiv id with version",
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "description": "DOI",
          "type": "string",
          "minLength": 1
        },
        "book": {
          "description": "book identifier, for example isbn:9780471433347",
          "type": "string",
          "minLength": 1
        },
        "mr": {
          "description": "MathSciNet MR number",
          "type": "string",
          "minLength": 1
        },
        "stacks": {
          "description": "Stacks Project tag",
          "type": "string",
          "minLength": 1
        },
        "kerodon": {
          "description": "Kerodon tag",
          "type": "string",
          "minLength": 1
        },
        "mathoverflow": {
          "description": "MathOverflow question id",
          "type": "string",
          "minLength": 1
        },
        "mathse": {
          "description": "Math Stack Exchange question id",
          "type": "string",
          "minLength": 1
        },
        "erdos": {
          "description": "Erdős problem number",
          "type": "string",
          "minLength": 1
        },
        "formal_conjectures": {
          "description": "formal-conjectures file and declaration",
          "type": "string",
          "minLength": 1
        },
        "palomar": {
          "description": "Palomar registry entry id",
          "type": "string",
          "minLength": 1
        },
