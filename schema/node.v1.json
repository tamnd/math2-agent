            "pattern": "^r-([0-9A-HJKMNP-TV-Z]{6}|[0-9A-HJKMNP-TV-Z]{10}|~[0-9a-f]{8})-[0-9]{2}$"
          },
          "uniqueItems": true
        }
      }
